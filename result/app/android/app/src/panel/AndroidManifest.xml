<?xml version="1.0" encoding="utf-8"?>
<!-- Panel flavor: like the original PianoRemote on the built-in LCD, the app is
     the instrument's home screen (MAIN + HOME). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- feature 86: silent PackageInstaller session; granted because the panel
         build is installed as a privileged system app (like the original priv-app) -->
    <uses-permission android:name="android.permission.INSTALL_PACKAGES"
        tools:ignore="ProtectedPermissions" />
    <application>
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>
</manifest>
