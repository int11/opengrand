{
  "name": "ca79ng-app",
  "version": "0.2.0",
  "private": true,
  "description": "OpenGrand controller app (panel + phone) — re-designed from REA analysis of Kawai PianoRemote",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/**/*.test.ts\"",
    "build": "node scripts/build.mjs",
    "dev": "node scripts/dev-server.ts",
    "mkupdate": "node scripts/mkupdate.mjs",
    "panelui": "node scripts/bundlecore.ts build",
    "panelui:key": "node scripts/bundlecore.ts key",
    "panelui:pack": "node scripts/bundlecore.ts pack",
    "panelui:inspect": "node scripts/bundlecore.ts inspect",
    "panelsim": "node scripts/panelsim.ts"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "esbuild": "0.25.10",
    "jsdom": "^26.1.0",
    "playwright-core": "1.64.1",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@types/node": "^24.19.2"
  }
}
