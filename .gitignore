# Build outputs and dependency trees (1.2 GB of the 1.4 GB working tree).
result/app/node_modules/
result/app/dist/
result/app/dist-kwm/
result/app/android/.gradle/
result/app/android/**/build/
result/app/android/local.properties
result/desktop/node_modules/
result/desktop/dist-electron/
# scripts/release_build.mjs output (APK, desktop zip, signed update.json): published as a GitHub release, not in git
/dist-release/
result/firmware/build/
result/stockfw/.venv/
result/stockfw/.toolchain
result/stockfw/build/
# Per-device OTA key: generated by `make image`, patched into
# ota_loader and used to sign slot payloads. NEVER commit it; the app holds a copy.
result/stockfw/secrets
# Editor / tool per-session data
.claude/
**/__pycache__/
*.pyc

# One-off analysis probes with hard-coded absolute paths; not part of any build.
result/stockfw/scratch/

# Input and device artifacts, 255 MB.
#   NOT tracked, but NOT disposable either:
#   - target/CA79NOR.BIN is the only NOR dump of this instrument and contains
#     per-device calibration that cannot be regenerated, plus personal data
#     (recordings, settings). Keep a copy outside this machine.
#   - target/CAx9_P06.SYS is the stock image every tool verifies against.
#   result/stockfw/ARTIFACTS.md records the sha256 of each one, so an accidental
#   substitution can be caught by re-hashing.
/target

# cave/build holds two declared INPUTS, so it is not treated as a build directory:
#   *.bin -> blob patches consumed by tools/patcher.py
#   *.elf -> symbol source read by tools/make_phase2_manifest.py (via nm)
# Only the object files are intermediates.  Tracked: the images' builds (cave_s0 = ota_loader_v4 stage-0, loader_s1 =
# ota_stage1, payload_pmain = ota_main); the round trips' test payloads (tools/images.py TEST_PAYLOADS) are local outputs.
result/stockfw/cave/build/*.o
result/stockfw/cave/build/payload_pcore2.*
result/stockfw/cave/build/payload_pbase2.*
result/stockfw/cave/build/payload_phook3.*
# CORE images: objects, -fstack-usage / -fcallgraph-info output and the linker map
result/stockfw/cave/build/core_*/

# make check / check-full logs (scripts/run_checks.py)
/.check/
